{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 2,
    "margin-right": 2,
    "margin-bottom": 0,
    "margin-left": 2,

    "modules-left": [
        "hyprland/workspaces",
        "tray"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "battery",
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p - %d %b %Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#232526' background='#ebdbb2'><b>{}</b></span>"
            }
	    },
    },


    "battery": {
        "format": "bat {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false,
    },
}

