# ============================================================
# Combined Hyprland config
# Merged from: hyprland.conf + modules/{variables,start,input,layout,workspace,keybinds}.conf
# ============================================================
 
# ---------------------------------------------
# variables.conf
# ---------------------------------------------
monitor = eDP-1, 1920x1200, 1920x0, 1
monitor = DP-2, 1920x1080@60, 0x0, 1
# monitor = HDMI-A-1, 1920x1080@144, 0x0, 1
 
workspace = 1, monitor:DP-2
workspace = 2, monitor:DP-2
workspace = 3, monitor:DP-2
workspace = 4, monitor:DP-2
 
# workspace = 1, monitor:HDMI-A-1
# workspace = 2, monitor:HDMI-A-1
# workspace = 3, monitor:HDMI-A-1
# workspace = 4, monitor:HDMI-A-1
workspace = 5, monitor:eDP-1
 
env = XCURSOR_SIZE,2
env = HYPRCURSOR_SIZE,2
env = XDG_CURRENT_DESKTOP,Hyprland
 
$terminalBash = kitty -e bash
$terminalZsh = kitty -e zsh
$fileManager = dolphin
$menu = tofi-run | xargs -r sh -c 
$mainMod = ALT
 
# ---------------------------------------------
# start.conf
# ---------------------------------------------
exec-once = hyprpaper
exec-once = waybar
 
# ---------------------------------------------
# input.conf
# ---------------------------------------------
input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options = caps:swapescape
    kb_rules =
 
    follow_mouse = 1
    accel_profile = flat
 
    sensitivity = -0.3 # -1.0 - 1.0, 0 means no modification.
 
    touchpad {
        natural_scroll = true
		scroll_factor = 0.2
    }
}
 
 
cursor {
	inactive_timeout = 1
}
 
# ---------------------------------------------
# layout.conf
# ---------------------------------------------
general { 
    gaps_in = 0
    gaps_out = 0
 
    border_size = 2
 
    col.active_border = rgba(8c8c8caa)
    col.inactive_border = rgba(595959aa)
 
    layout = dwindle
 
}
 
dwindle {
    preserve_split = true
}
 
master {
    new_status = master
}
 
animations {
	enabled = true
	animation = windows, 1, 1.1, default, popin 0%
	animation = workspaces, 1, 2, default, slide 0%
}
 
misc {
	disable_splash_rendering = true
	disable_hyprland_logo = true
}
 
# ---------------------------------------------
# workspace.conf
# ---------------------------------------------
windowrule {
    name = suppress
    match:class = .*
 
    suppress_event = maximize
}
 
# game engine stuff 
windowrule {
	name = float-dev
	match:title = ^(opengl game|python|sim)$
	float = true
}
 
windowrule {
	name = info-btop
	match:class = ^(kitty)$
	match:title = ^(info-btop)$
 
	size = 800 400
	stay_focused = on
	float = true
}
 
# ---------------------------------------------
# keybinds.conf
# ---------------------------------------------
 
# Master toggle to disable all keybinds
bind = $mainMod, F11, submap, clean
 
# Submap for clean (disabled state)
submap = clean
 
# Keybind to return to the default submap (re-enable keybinds)
bind = $mainMod SHIFT, F11, submap, reset
 
# Fullscreen toggle (active in clean submap)
bind = $mainMod, I, fullscreen,
 
# Submap for reset (default keybinds enabled)
submap = reset
 
bind = $mainMod, RETURN, exec, $terminalBash
bind = $mainMod SHIFT, RETURN, exec, $terminalZsh
bind = $mainMod, D, exec, discord 
bind = $mainMod, F, exec, firefox
bind = $mainMod, B, exec, blender
bind = $mainMod, C, killactive,
bind = $mainMod, M, exit, # REPLACEABLE
bind = $mainMod, G, exec, $fileManager
bind = $mainMod, U, togglefloating, # REPLACEABLE
bind = $mainMod, A, exec, $menu
bind = $mainMod, I, fullscreen,
bind = $mainMod, P, pseudo,
bind = $mainMod, O, layoutmsg, togglesplit
bind = $mainMod, V, exec, kitty --override font_size=7 --title info-btop bash -c "btop"
bind = , Print, exec, grim -g "$(slurp)" - | wl-copy
bind = $mainMod, T, exec, kitty bash -c "nvim ~/notes/todo.txt"
bind = $mainMod SHIFT, T, exec, kitty bash -c "nvim ~/notes/journal.txt"
bind = $mainMod, Y, exec, hyprctl keyword decoration:screen_shader "./misc/shader.glsl"
bind = $mainMod SHIFT, Y, exec, hyprctl keyword decoration:screen_shader ""
 
bind = $mainMod SHIFT, M, exec, shutdown now
bind = $mainMod SHIFT, N, exec, reboot
 
bind = $mainMod SHIFT, z, movecurrentworkspacetomonitor, l
bind = $mainMod SHIFT, x, movecurrentworkspacetomonitor, r
 
# Move focus
bind = $mainMod, H, movefocus, l
bind = $mainMod, J, movefocus, d
bind = $mainMod, K, movefocus, u
bind = $mainMod, L, movefocus, r
 
# Move windows
bind = $mainMod SHIFT, H, movewindow, l
bind = $mainMod SHIFT, J, movewindow, d
bind = $mainMod SHIFT, K, movewindow, u
bind = $mainMod SHIFT, L, movewindow, r
 
# Resize windows
bind = $mainMod CTRL, H, resizeactive, -50 0
bind = $mainMod CTRL, J, resizeactive, 0 50
bind = $mainMod CTRL, K, resizeactive, 0 -50
bind = $mainMod CTRL, L, resizeactive, 50 0
 
bind = $mainMod, Q, workspace, 1
bind = $mainMod, W, workspace, 2
bind = $mainMod, E, workspace, 3
bind = $mainMod, R, workspace, 4
# for "locking"
# bind = $mainMod SHIFT, L, workspace, 10
 
bind = $mainMod SHIFT, Q, movetoworkspace, 1
bind = $mainMod SHIFT, W, movetoworkspace, 2
bind = $mainMod SHIFT, E, movetoworkspace, 3
bind = $mainMod SHIFT, R, movetoworkspace, 4
 
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow
 

